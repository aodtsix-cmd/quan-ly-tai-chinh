# Sao chép file này thành ".env" (cùng thư mục gốc dự án) rồi điền giá trị thật.
# ".env" đã bị chặn trong .gitignore — không bao giờ commit file đó.

# Bắt buộc để chạy web_app.py — mật khẩu dùng chung để đăng nhập.
APP_PASSWORD=

# Bắt buộc để dùng /import (đọc ảnh) và mọi tính năng gợi ý AI (ngân sách,
# mục tiêu, mô phỏng chi tiêu, dự báo, tóm tắt hằng ngày).
# Lấy miễn phí tại https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Tùy chọn — model dùng cho các tác vụ AI thông thường (diễn giải, gợi ý).
# Mặc định gemini-flash-latest nếu để trống (đã xác nhận chạy được với key thật).
GEMINI_MODEL=

# Tùy chọn — model dùng cho tác vụ AI nặng hơn (mô phỏng chi tiêu, dự báo dòng tiền).
# Mặc định gemini-pro-latest nếu để trống.
GEMINI_MODEL_HEAVY=

# Tùy chọn — khóa ký session Flask. Nếu để trống, mỗi lần khởi động lại server
# sẽ sinh khóa ngẫu nhiên mới (đăng xuất mọi người). Đặt cố định khi deploy thật.
SECRET_KEY=

# Tùy chọn — bật khối "Bối cảnh tham khảo" (tin tức vĩ mô, dùng Google Search
# grounding) ở trang /forecast. Mặc định TẮT (an toàn, ít tốn kém nhất).
# Đặt đúng giá trị "1" để bật; để trống hoặc bất kỳ giá trị nào khác là tắt.
ENABLE_MACRO_CONTEXT=
